# Copy this file to .env and fill in your own values:   cp .env.example .env
# .env holds secrets and is never committed (see .gitignore).

# The alert database (PostgreSQL). Paste the connection string your hosting provider gives you, e.g.
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Special characters in the password must be URL-encoded (e.g. @ -> %40, # -> %23).
# For a local database instead:  docker-compose --profile local-db up -d --wait db   and then
#   DATABASE_URL=postgresql://logs:logs@localhost:5440/logs      (programs on this computer)
#   DATABASE_URL=postgresql://logs:logs@db:5432/logs             (the services inside Docker)
DATABASE_URL=
